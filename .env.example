# Application
APP_URL=http://localhost:5000
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=timecapsule
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=this_is_a_very_secret_key_change_it_in_production_12345
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Email (SMTP)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password
MAIL_FROM=noreply@timecapsule.app

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=+123456789

# Scheduler
SCHEDULER_INTERVAL_MS=60000
SCHEDULER_BATCH_SIZE=50

# Capsule business rules
CAPSULE_MIN_MINUTES_FROM_NOW=5
CAPSULE_MAX_RETRY_ATTEMPTS=3

# CORS
CORS_ALLOWED_ORIGINS=* # http://localhost:4200

# Password reset
PASSWORD_RESET_TOKEN_TTL=3600
